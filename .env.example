# Copy to .env and fill in. Do not commit .env.

# ---------------------------------------------------------------- Twilio
# Voice (SIP trunk origination) + WhatsApp Business sender.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# SETTLED (plan.md 4.0): US number. An Indian CLI is rejected at Twilio's edge.
CALLER_ID=+14784008435
# A different Indian mobile to ring during testing, E.164.
TEST_TO=+91xxxxxxxxxx
# The evaluator. Do not point this at a test number by accident.
TARGET_NUMBER=+918688664337
# WhatsApp sender once it reaches ONLINE, e.g. whatsapp:+14784008435
TWILIO_WHATSAPP_FROM=

# ---------------------------------------------------------------- Sarvam
# One vendor for STT + LLM + TTS. INR billing, UPI top-up.
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b-conversations
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v2
# Leave blank until you have listened to scripts/voice_samples/ and picked by ear.
SARVAM_TTS_SPEAKER=

# ---------------------------------------------------------------- LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# From `lk sip outbound create`
SIP_OUTBOUND_TRUNK_ID=

# ---------------------------------------------------------------- Neon
# Use NullPool in the engine or the 100 compute-hours/month burns out (plan.md 2.3).
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------- Assets
# GitHub Pages, NOT raw.githubusercontent.com -- raw serves the wrong MIME type
# and WhatsApp will not render the document header.
RESUME_URL=https://<username>.github.io/<repo>/resume.pdf
ARCH_IMAGE_URL=https://<username>.github.io/<repo>/architecture.png
# Shown in the follow-up message so they can call you back.
MY_MOBILE=+91xxxxxxxxxx
